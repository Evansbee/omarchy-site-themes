#!/bin/bash

# Write the current Omarchy theme palette into the extension as CSS variables.
# Runs from the theme-set and font-set hooks; the extension re-reads colors.css on its own.

set -euo pipefail

ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
COLORS=${1:-$HOME/.local/state/omarchy/current/theme/colors.toml}
OUT=$ROOT/extension/colors.css

[[ -f $COLORS ]] || exit 0

declare -A c
while IFS=$'\t' read -r key value; do
  c[$key]=$value
done < <(omarchy-theme-color --file "$COLORS" --all)

rgb() {
  local hex=${1#\#}
  printf '%d, %d, %d' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

# --om-* name -> colors.toml key
vars=(
  bg:background fg:foreground fg-strong:bright_foreground accent:accent
  red:red green:green yellow:yellow orange:orange blue:blue magenta:magenta cyan:cyan
)

tmp=$(mktemp "$OUT.XXXXXX")
{
  echo "/* Generated by omarchy-site-themes-sync. Do not edit. */"
  echo ":root {"
  echo "  --om-mode: ${c[mode]:-dark};"
  echo "  --om-font: \"$(omarchy-font-current 2>/dev/null || echo monospace)\";"
  for pair in "${vars[@]}"; do
    echo "  --om-${pair%%:*}: ${c[${pair#*:}]};"
  done
  for name in bg fg accent; do
    key=$(printf '%s\n' "${vars[@]}" | grep "^$name:" | cut -d: -f2)
    echo "  --om-$name-rgb: $(rgb "${c[$key]}");"
  done
  echo "}"
} >"$tmp"
chmod 644 "$tmp"
mv "$tmp" "$OUT"
